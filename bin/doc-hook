#!/bin/sh
# Run a doc hook (publish_guard, reply_check, skill_router) with the TypeSafe
# key injected by hush. Without hush or python3 the hook checks nothing and
# exits 0: a missing tool never breaks a session.
#
# Everything after `--` runs wherever hush runs, which may be another machine
# than this script (a container forwarding hush to its host shares only the
# paths): so python3 is looked up there, and PYTHONPATH travels in the command.
hook="$1"
root="$(cd "$(dirname "$0")/.." && pwd)"
hush_bin="$(command -v hush 2>/dev/null)"
[ -n "$hush_bin" ] || { [ -x "$HOME/.local/bin/hush" ] && hush_bin="$HOME/.local/bin/hush"; }
if [ -z "$hush_bin" ]; then
    cat >/dev/null
    exit 0
fi
exec "$hush_bin" run --name TYPESAFE_API_KEY --env TYPESAFE_API_KEY --redact -- \
    env PYTHONPATH="$root" sh -c \
    'command -v python3 >/dev/null || { cat >/dev/null; exit 0; }; exec python3 -m "doc.$0"' "$hook"
