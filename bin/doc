#!/usr/bin/env python3
"""doc — hand a task to the right agent.

  doc "rename foo to bar in utils.py"      interactive session with the chosen agent
  doc -p "…"                               headless (print mode)
  doc --dry-run "…"                        only show the decision

Mechanical, low-risk work the router is confident about goes to `oclaude`;
everything else — and anything when the router is unavailable — to `claude`.
"""
import json
import os
import shutil
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
PASSED = ("DOC_USAGE_LOG", "DOC_JEV_MODEL")


def decide(task):
    hush = shutil.which("hush") or os.path.expanduser("~/.local/bin/hush")
    # The command after `--` runs wherever hush runs (possibly a container's
    # host) and inherits only the key, so it names python3 and carries
    # PYTHONPATH and any DOC_* setting itself.
    settings = ["%s=%s" % (name, os.environ[name]) for name in PASSED if os.environ.get(name)]
    command = [hush, "run", "--name", "TYPESAFE_API_KEY", "--env", "TYPESAFE_API_KEY", "--redact",
               "--", "env", "PYTHONPATH=" + ROOT] + settings + ["python3", "-m", "doc.route", task]
    try:
        out = subprocess.run(command, capture_output=True, text=True, timeout=60).stdout
        return json.loads(out.strip().splitlines()[-1])
    except (OSError, ValueError, IndexError, subprocess.SubprocessError) as error:
        return {"target": "claude", "why": "router unavailable: %s" % error}


def main(argv):
    dry = "--dry-run" in argv
    headless = "-p" in argv or "--print" in argv
    words = [a for a in argv if a not in ("--dry-run", "-p", "--print")]
    task = " ".join(words).strip()
    if not task:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    decision = decide(task)
    detail = ", ".join("%s %s" % (k, v) for k, v in decision.items() if k != "target")
    print("doc → %s (%s)" % (decision["target"], detail), file=sys.stderr)
    if dry:
        return 0
    extra = ["-p"] if headless else []
    if decision["target"] == "oclaude":
        args = ["oclaude", "--"] + extra + [task]
    else:
        args = ["claude"] + extra + [task]
    os.execvp(args[0], args)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
